{
  "name": "yt-mp3-api",
  "version": "1.0.0",
  "description": "Production-ready YouTube-to-MP3 conversion API",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "NODE_ENV=development node --watch src/index.js",
    "test": "node --test tests/**/*.test.js",
    "test:load": "autocannon -c 10 -d 30 http://localhost:3000/health",
    "lint": "eslint src/",
    "build": "docker build -t yt-mp3-api:latest .",
    "docker:run": "docker run -p 3000:3000 --env-file .env yt-mp3-api:latest",
    "security:audit": "npm audit",
    "security:check": "node scripts/security-check.js"
  },
  "dependencies": {
    "fastify": "^4.24.3",
    "fastify-cors": "^9.0.1",
    "fastify-helmet": "^11.1.1",
    "fastify-rate-limit": "^9.1.0",
    "dotenv": "^16.3.1",
    "youtube-dl-exec": "^2.4.12",
    "fluent-ffmpeg": "^2.1.2",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "node-cache": "^5.1.2",
    "p-queue": "^7.4.1",
    "axios": "^1.6.2",
    "joi": "^17.11.0",
    "uuid": "^9.0.1",
    "redis": "^4.6.12",
    "ioredis": "^5.3.2"
  },
  "devDependencies": {
    "eslint": "^8.54.0",
    "autocannon": "^7.10.0",
    "node-test-runner": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
