# Server
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Security
API_KEY=your-secure-api-key-here-change-in-production
API_KEY_HASH=your-hashed-api-key
CORS_ORIGIN=https://yourdomain.com
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000

# YouTube & Conversion
YOUTUBE_DL_PATH=/usr/local/bin/yt-dlp
FFMPEG_PATH=/usr/local/bin/ffmpeg
CONVERSION_TIMEOUT_MS=300000
MAX_DURATION_SECONDS=3600
QUEUE_MAX_SIZE=1000

# Storage
TEMP_DIR=/tmp/yt-mp3
OUTPUT_DIR=/storage/mp3s
CLEANUP_INTERVAL_MS=3600000
FILE_RETENTION_HOURS=24

# Redis (Optional - for distributed caching)
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=3600

# Logging
LOG_LEVEL=info
AUDIT_LOG_PATH=/var/log/yt-mp3-audit.log

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# Abuse Protection
MAX_REQUESTS_PER_IP_HOUR=50
MAX_REQUESTS_PER_KEY_HOUR=500
BAN_THRESHOLD=10
BAN_DURATION_MS=3600000

# Circuit Breaker
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT_MS=60000
